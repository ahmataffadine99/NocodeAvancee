# Copy this file to .env only if you need to change these local defaults.
# Never put API keys, passwords, or other secrets in this file or in Git.
BASEROW_IMAGE=baserow/baserow:2.4.1
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.45.6
MAILPIT_IMAGE=axllent/mailpit:v1.21
BASEROW_PUBLIC_URL=http://localhost:8081
BASEROW_API_TOKEN=
BASEROW_TABLE_COLLABORATORS_ID=366
BASEROW_TABLE_TECHNICIANS_ID=367
BASEROW_TABLE_TICKETS_ID=368
BASEROW_TABLE_REPLIES_ID=369
BASEROW_TABLE_KNOWLEDGEBASE_ID=370
BASEROW_TABLE_AUDITLOG_ID=371
TIMEZONE=Europe/Paris
AI_CONFIDENCE_THRESHOLD=0.6
AI_CATEGORIES=hardware,access,software,network,onboarding,other
AI_PRIORITIES=P1,P2,P3,P4
FALLBACK_CATEGORY=other
FALLBACK_PRIORITY=P3
URGENT_PRIORITY=P1
MANUAL_REVIEW_TAG=manual_review
REPORT_PERIOD_DAYS=7
# Relances de l'appel IA : nombre de relances, puis attente = base x 2^essai (5 s, 10 s...)
AI_MAX_RETRIES=2
AI_BACKOFF_BASE_SECONDS=5
SLA_HOURS_P1=4
SLA_HOURS_P2=8
SLA_HOURS_P3=24
SLA_HOURS_P4=72
SLA_WARNING_HOURS=1
MAIL_FROM=helpdesk@example.test
APPROVER_EMAIL=demo.approver@example.test
REPORT_EMAIL=demo.manager@example.test
ERROR_EMAIL=demo.admin@example.test

# Utilis�s uniquement par les scripts d'installation (jamais versionn�s dans .env)
BASEROW_EMAIL=
BASEROW_PASSWORD=
GEMINI_API_KEY=
