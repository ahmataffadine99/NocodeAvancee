          "toEmail": "={{ $env.REPORT_EMAIL }}",
          "subject": "={{ '[HelpDesk] Weekly report ' + $json.stats.period_end }}",
          "emailFormat": "text",
          "text": "={{ $json.report }}",
          "options": {}
        },
        "credentials": {
