      {
        "id": "d8b344e0-959d-0e22-247b-f9dce4637ba4",
        "name": "Parse Classification",
        "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
        "typeVersion": 1.3,
        "position": [
          2100,
          680
        ],
        "parameters": {
          "schemaType": "manual",
          "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"hardware\",\n        \"access\",\n        \"software\",\n        \"network\",\n        \"onboarding\",\n        \"other\"\n      ]\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"P1\",\n        \"P2\",\n        \"P3\",\n        \"P4\"\n      ]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"maxLength\": 279\n    },\n    \"required_skill\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"hardware\",\n        \"access\",\n        \"software\",\n        \"network\",\n        \"onboarding\",\n        \"other\"\n      ]\n    },\n    \"needs_human_review\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"priority\",\n    \"confidence\",\n    \"summary\",\n    \"required_skill\",\n    \"needs_human_review\"\n  ],\n  \"additionalProperties\": false\n}"
        }
      },
      {
        "id": "3bb99bca-3a6f-4e2c-aa22-8bc7ae9e6d4f",
        "name": "Apply Classification Rules",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          2200,
          460
        ],
        "parameters": {
          "mode": "raw",
          "jsonOutput": "={{ (() => {\n  const ctx = $('Prepare Requester Context').first().json;\n  const ai = $json.output;\n  const cats = [\"hardware\",\"access\",\"software\",\"network\",\"onboarding\",\"other\"];\n  const threshold = Number($env.AI_CONFIDENCE_THRESHOLD);\n  const wellFormed = !!ai && cats.includes(ai.category) && ['P1', 'P2', 'P3', 'P4'].includes(ai.priority) && typeof ai.confidence === 'number' && typeof ai.summary === 'string' && ai.summary.length > 0 && ai.summary.length < 280 && ai.required_skill === ai.category && typeof ai.needs_human_review === 'boolean';\n  const ok = wellFormed && ai.confidence >= threshold;\n  return {\n    ...ctx,\n    ai_ok: ok,\n    ai_error: ok ? null : (wellFormed ? 'low_confidence' : 'parsing_failed'),\n    category: ok ? ai.category : 'other',\n    priority: ok ? ai.priority : 'P3',\n    confidence: typeof ai?.confidence === 'number' ? ai.confidence : 0,\n    summary: wellFormed ? ai.summary : '',\n    required_skill: ok ? ai.required_skill : 'other',\n    needs_human_review: ok ? ai.needs_human_review : true,\n  };\n})() }}",
          "options": {}
        }
      },
