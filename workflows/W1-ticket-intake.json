          "jsonOutput": "={{ (() => {\n  const cls = $('Apply Classification Rules').first().json;\n  const tech = $('Select Least Loaded Technician').isExecuted ? $('Select Least Loaded Technician').first().json : {};\n  const assigned = !!tech.id;\n  const manual = !cls.ai_ok || cls.needs_human_review || !assigned || !cls.requester_id;\n  return {\n    ...cls,\n    assignee_id: assigned ? tech.id : null,\n    assignee_name: assigned ? tech.name : '',\n    assignee_email: assigned ? tech.email : '',\n    assignee_open_tickets: Number(tech.open_tickets ?? 0),\n    tags: manual ? ['manual_review'] : [],\n    manual_review: manual,\n    status: 'new',\n    sla_hours: Number($env['SLA_HOURS_' + cls.priority]),\n    sla_due_at: $now.plus({ hours: Number($env['SLA_HOURS_' + cls.priority]) }).toISO(),\n  };\n})() }}",
