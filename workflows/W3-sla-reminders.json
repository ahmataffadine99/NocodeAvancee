      {
        "id": "cd1b933d-ad7b-552c-fc0f-18a9664f54a9",
        "name": "Filter Due Tickets",
        "type": "n8n-nodes-base.filter",
        "typeVersion": 2.2,
        "position": [
          660,
          300
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "id": "a9c682cb-984f-547d-e2e0-a316d71d42fc",
                "leftValue": "={{ !['closed', 'late'].includes($json.status?.value) && ($json.assignee ?? []).length > 0 && !!$json.sla_due_at && DateTime.fromISO($json.sla_due_at) <= $now.plus({ hours: Number($env.SLA_WARNING_HOURS) }) }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        }
      },
      {
        "id": "620d7194-dfc6-f84a-1ba3-49e2ddfcae3f",
        "name": "Fetch Assigned Technician",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          880,
          300
        ],
        "parameters": {
          "method": "GET",
          "url": "={{ $env.BASEROW_INTERNAL_URL + '/api/database/rows/table/' + $env.BASEROW_TABLE_TECHNICIANS_ID + '/' + $json.assignee[0].id + '/' }}",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
