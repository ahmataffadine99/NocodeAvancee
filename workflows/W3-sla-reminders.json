          "httpHeaderAuth": {
            "id": "bsrwHdrAuth0001",
            "name": "Baserow Header Auth"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "id": "48f9600e-d831-c63a-a5ad-dda64f89fd75",
        "name": "Notify Technician Of SLA",
        "type": "n8n-nodes-base.emailSend",
        "typeVersion": 2.1,
        "position": [
          1100,
          300
        ],
        "parameters": {
          "fromEmail": "={{ $env.MAIL_FROM }}",
          "toEmail": "={{ $('Fetch Assigned Technician').item.json.email }}",
          "subject": "={{ '[SLA ' + (DateTime.fromISO($('Filter Due Tickets').item.json.sla_due_at) <= $now ? 'OVERDUE' : 'DUE SOON') + '] ' + $('Filter Due Tickets').item.json.reference }}",
          "emailFormat": "text",
          "text": "={{ 'Ticket ' + $('Filter Due Tickets').item.json.reference + ' (' + $('Filter Due Tickets').item.json.priority.value + ') - ' + $('Filter Due Tickets').item.json.subject + '\\nSLA due: ' + $('Filter Due Tickets').item.json.sla_due_at + '\\nCurrent status: ' + $('Filter Due Tickets').item.json.status.value + '\\n\\n' + (DateTime.fromISO($('Filter Due Tickets').item.json.sla_due_at) <= $now ? 'The SLA deadline has passed. Please handle this ticket now.' : 'The SLA deadline is approaching.') }}",
          "options": {}
        },
        "credentials": {
          "smtp": {
            "id": "mailpitSmtp0001",
            "name": "Mailpit SMTP"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "id": "fc021606-1f39-daf1-939f-3688b1e8c306",
        "name": "Is SLA Overdue",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          1320,
          300
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "id": "ecb456f5-137a-e4e5-e6e5-7863492e26dc",
                "leftValue": "={{ DateTime.fromISO($('Filter Due Tickets').item.json.sla_due_at) <= $now }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        }
      },
      {
        "id": "d8604464-3b79-6c3c-3a43-43038ccc0239",
        "name": "Mark Ticket Late",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1540,
          220
        ],
        "parameters": {
          "method": "PATCH",
          "url": "={{ $env.BASEROW_INTERNAL_URL + '/api/database/rows/table/' + $env.BASEROW_TABLE_TICKETS_ID + '/' + $('Filter Due Tickets').item.json.id + '/' }}",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "user_field_names",
                "value": "true"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ status: 'late' }) }}",
          "options": {}
        },
        "credentials": {
          "httpHeaderAuth": {
            "id": "bsrwHdrAuth0001",
            "name": "Baserow Header Auth"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "id": "e8cec97a-7880-dea2-a05e-f31d194b5523",
        "name": "Log SLA Reminder",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1.2,
        "position": [
          1760,
          300
        ],
        "parameters": {
          "workflowId": {
            "__rl": true,
            "value": "subAuditLog00001",
            "mode": "id"
          },
          "workflowInputs": {
            "mappingMode": "defineBelow",
            "value": {
              "ticket_id": "={{ $('Filter Due Tickets').item.json.id }}",
              "action": "sla_reminder",
              "details": "={{ JSON.stringify({ reference: $('Filter Due Tickets').item.json.reference, priority: $('Filter Due Tickets').item.json.priority.value, sla_due_at: $('Filter Due Tickets').item.json.sla_due_at, previous_status: $('Filter Due Tickets').item.json.status.value, overdue: DateTime.fromISO($('Filter Due Tickets').item.json.sla_due_at) <= $now, technician: $('Fetch Assigned Technician').item.json.name, success: true }) }}",
              "outcome": "={{ DateTime.fromISO($('Filter Due Tickets').item.json.sla_due_at) <= $now ? 'success: overdue, ticket set to late' : 'success: due soon, reminder sent' }}"
            },
            "matchingColumns": [],
            "schema": [],
            "attemptToConvertTypes": false,
            "convertFieldsToString": false
          },
          "mode": "each",
          "options": {
            "waitForSubWorkflow": true
          }
        }
      }
